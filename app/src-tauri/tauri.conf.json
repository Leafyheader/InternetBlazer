{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "InternetBlazer",
  "identifier": "org.internetblazer.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "InternetBlazer",
        "width": 920,
        "height": 580,
        "minWidth": 760,
        "minHeight": 480,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMxOTY4QTBDRkY4MzI0MzgKUldRNEpJUC9ESXFXd1hYSHZWaUtaWVo5K050NzF3ZjFiNDdFbE9McGFWUEdwcWtyRjM4WnN6V0EK",
      "endpoints": ["https://github.com/Leafyheader/InternetBlazer/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
