{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "npm run build && node scripts/build-host.mjs"
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/blazer-host"],
    "publisher": "Leafyhead Technologies",
    "copyright": "© 2026 Leafyhead Technologies",
    "homepage": "https://github.com/Leafyheader/InternetBlazer",
    "license": "MIT OR Apache-2.0",
    "shortDescription": "Download manager",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
