{
  "manifest_version": 3,
  "name": "InternetBlazer",
  "version": "0.1.0",
  "description": "Sends downloads to the InternetBlazer download manager.",
  "key": "",
  "permissions": ["contextMenus", "cookies", "downloads", "nativeMessaging", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["common.js", "background.js"]
  },
  "action": {
    "default_title": "InternetBlazer",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/32.png", "32": "icons/32.png" }
  },
  "icons": { "16": "icons/32.png", "32": "icons/32.png", "48": "icons/64.png", "128": "icons/128.png" },
  "browser_specific_settings": {
    "gecko": { "id": "internetblazer@internetblazer.org", "strict_min_version": "128.0" }
  }
}
